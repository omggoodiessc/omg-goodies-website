# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file or share these values publicly.

# From Square Developer Dashboard → your app → Credentials.
# Use the Sandbox Access Token while testing, the Production one when live.
SQUARE_ACCESS_TOKEN=

# From Square Developer Dashboard → your app → Locations (or Square Dashboard → Account & Settings → Locations).
SQUARE_LOCATION_ID=

# "sandbox" while testing, "production" once you're ready to take real payments.
SQUARE_ENVIRONMENT=sandbox

# Same published Google Sheet CSV link used in frontend/config.js.
# The server uses this to double-check prices so orders can't be tampered with.
MENU_CSV_URL=

# Flat delivery fee in dollars, used as a fallback if the site doesn't send one.
DELIVERY_FEE=5

# Port the server listens on (most hosts set this automatically).
PORT=3000
